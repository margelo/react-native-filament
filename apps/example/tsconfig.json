{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "react-native-filament": [
        "../../packages/react-native-filament/src/index"
      ],
      "react-native-filament/*": [
        "../../packages/react-native-filament/*"
      ]
    },
    "types": [
      "react-native"
    ],
    "lib": [
      "es2023"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "index.js",
    "../shared/src",
    "harness"
  ]
}
