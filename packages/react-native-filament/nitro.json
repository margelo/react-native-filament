{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "filament"
  ],
  "ios": {
    "iosModuleName": "NitroFilament"
  },
  "android": {
    "androidNamespace": [
      "filament"
    ],
    "androidCxxLibName": "NitroFilament"
  },
  "autolinking": {
    "FilamentFactory": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridFilamentFactory"
      }
    },
    "FilamentView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFilamentView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFilamentView"
      }
    },
    "AssetIO": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAssetIO"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridAssetIO"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
