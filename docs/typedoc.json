{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../packages/react-native-filament/src/index.ts",
    "../packages/react-native-filament/src/specs/**/*.nitro.ts"
  ],
  "tsconfig": "../packages/react-native-filament/tsconfig.json",
  "outputs": [
    {
      "name": "json",
      "path": ".source/typedoc.json"
    }
  ],
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "logLevel": "Warn",
  "blockTags": [
    "@default",
    "@defaultValue",
    "@example",
    "@param",
    "@returns",
    "@throws",
    "@deprecated",
    "@see",
    "@remarks",
    "@thread",
    "@platform",
    "@note"
  ],
  "entryPointStrategy": "resolve"
}