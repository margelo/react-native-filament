{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation website for react-native-filament.",
  "scripts": {
    "api": "typedoc --options typedoc.json && bun scripts/generate-api.ts",
    "dev": "bun run api && fumadocs-mdx && next dev",
    "build": "bun run api && fumadocs-mdx && next build",
    "check:api": "node scripts/check-api-types.cjs",
    "poster": "bun scripts/render-hero-poster.mjs",
    "build:cloudflare": "DOCS_BASE_PATH= bun run build",
    "deploy:cloudflare": "bun run build:cloudflare && wrangler deploy",
    "typecheck": "bun run api && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "1.17.0",
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.0",
    "typedoc": "0.28.19",
    "typescript": "~5.9.2",
    "wrangler": "4.151.1"
  }
}
